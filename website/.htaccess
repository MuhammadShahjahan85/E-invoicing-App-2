# =============================================================================
#  Veridian Partners website — server settings (Hostinger / Apache / LiteSpeed)
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /404.php
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType image/svg+xml .svg

# Keep private files private
<FilesMatch "(^\.|^config\.php$|\.(md|log|ini|sh|bak|sql)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS -----------------------------------------------------------------
  # Easiest: hPanel → Security → SSL → turn on "Force HTTPS".
  # Or remove the # from the next two lines once your SSL certificate is active.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Internal folders are never served ------------------------------------
  RewriteRule ^(includes|storage)(/|$) - [F,L]

  # --- Generated files --------------------------------------------------------
  RewriteRule ^sitemap\.xml$ sitemap-xml.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^search-index\.json$ search-index.php [L]

  # --- Clean addresses: /about.php → /about, /index.php → / -----------------
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+((?!admin/)[^\s?]+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # --- No trailing slashes (except real folders) ------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # --- Detail pages -------------------------------------------------------------
  RewriteRule ^services/([a-z0-9-]+)$ service.php?slug=$1 [L,QSA]
  RewriteRule ^industries/([a-z0-9-]+)$ industry.php?slug=$1 [L,QSA]
  RewriteRule ^knowledge-bank/([a-z0-9-]+)$ article.php?slug=$1 [L,QSA]

  # --- Pages without .php -------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ $1.php [L]

  # --- Anything else: friendly 404 page ---------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

# --- Security headers ---------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # After HTTPS is working, remove the # below for extra protection (HSTS):
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Compression ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript text/javascript image/svg+xml application/manifest+json
</IfModule>

# --- Browser caching (files carry a version, so long caching is safe) -----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Build output
/dist/
/bin/
*.exe
# Runtime data (never commit client data or keys)
/data/
*.db
*.db-wal
*.db-shm
master.key
license.lic
vendor-private.key
# Frontend
/web/node_modules/
# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
# Windows resources made by go-winres during release builds
*.syso
# Website: runtime data written on the server (enquiries, CVs, secrets)
/website/storage/*
!/website/storage/.htaccess
!/website/storage/index.html
